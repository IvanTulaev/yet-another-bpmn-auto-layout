    <bpmn:sequenceFlow id="Flow_c" name="c" sourceRef="Gateway_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_other" name="other" sourceRef="Gateway_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_end_1" sourceRef="Task_1" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_end_2" sourceRef="Task_2" targetRef="EndEvent_2" />
  </bpmn:process>
