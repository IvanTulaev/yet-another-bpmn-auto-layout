<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PizzaDelivery" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_PizzaDelivery" name="Pizza delivery" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_OrderAccepted" name="Order accepted?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Pickup" name="Pickup?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Courier" name="Courier available?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CallCourier" name="Call a courier">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DeliverPizza" name="Deliver pizza">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CustomerHappy" name="Customer happy?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_HandleComplaint" name="Handle complaint">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Compensate" name="Compensation needed?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CloseOrder" name="Close order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OrderClosed" name="Order closed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_Late" name="Late by 60 minutes" attachedToRef="Task_DeliverPizza">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Late" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderReceived" targetRef="Gateway_OrderAccepted" />
    <bpmn:sequenceFlow id="Flow_2" name="yes" sourceRef="Gateway_OrderAccepted" targetRef="Gateway_Pickup" />
    <bpmn:sequenceFlow id="Flow_3" name="no" sourceRef="Gateway_OrderAccepted" targetRef="Task_HandleComplaint" />
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gateway_Pickup" targetRef="Gateway_Courier" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Pickup" targetRef="Task_CloseOrder" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_Courier" targetRef="Task_CallCourier" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gateway_Courier" targetRef="Task_DeliverPizza" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_CallCourier" targetRef="Task_DeliverPizza" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_DeliverPizza" targetRef="Gateway_CustomerHappy" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gateway_CustomerHappy" targetRef="Task_HandleComplaint" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_HandleComplaint" targetRef="Gateway_Compensate" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gateway_Compensate" targetRef="Task_CloseOrder" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CloseOrder" targetRef="EndEvent_OrderClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_PizzaDelivery">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_PizzaDelivery" bpmnElement="Process_PizzaDelivery">
      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderAccepted_di" bpmnElement="Gateway_OrderAccepted" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Pickup_di" bpmnElement="Gateway_Pickup" isMarkerVisible="true">
        <dc:Bounds x="350" y="465" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Courier_di" bpmnElement="Gateway_Courier" isMarkerVisible="true">
        <dc:Bounds x="500" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CallCourier_di" bpmnElement="Task_CallCourier">
        <dc:Bounds x="625" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliverPizza_di" bpmnElement="Task_DeliverPizza">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CustomerHappy_di" bpmnElement="Gateway_CustomerHappy" isMarkerVisible="true">
        <dc:Bounds x="950" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandleComplaint_di" bpmnElement="Task_HandleComplaint">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Compensate_di" bpmnElement="Gateway_Compensate" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseOrder_di" bpmnElement="Task_CloseOrder">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OrderClosed_di" bpmnElement="EndEvent_OrderClosed">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_Late_di" bpmnElement="BoundaryEvent_Late">
        <dc:Bounds x="807" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="490" />
        <di:waypoint x="350" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="400" y="490" />
        <di:waypoint x="525" y="490" />
        <di:waypoint x="525" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="400" y="490" />
        <di:waypoint x="1425" y="490" />
        <di:waypoint x="1425" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="525" y="235" />
        <di:waypoint x="525" y="350" />
        <di:waypoint x="625" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="550" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="825" y="350" />
        <di:waypoint x="825" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="950" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1000" y="210" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1125" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
